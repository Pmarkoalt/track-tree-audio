PORT=8080
DEMUCSSVC_TOKEN=
# pydantic-settings list fields require JSON arrays. Allow exact configured paths/origins.
API_WEBHOOK_URL_ALLOWLIST=["http://localhost:4000/webhooks/demucs"]
MEDIA_URL_ORIGINS=["http://localhost:9000","http://127.0.0.1:9000"]
REDIS_URL=redis://localhost:6379/0
# Give each disposable run/deployment its own prefix; never flush shared Redis.
AUDIO_REDIS_PREFIX=track-tree-audio:
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
AUDIO_DEVICE=cpu
AUDIO_WORKER_THREADS=2
AUDIO_JOB_TIMEOUT_SECONDS=1500
# The service uses scoped presigned transfers; no database/S3/identity/billing keys.
